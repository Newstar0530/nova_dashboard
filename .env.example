# 複製成 .env 後填入（.env 不會被 commit）

# Obsidian vault 路徑（預設為 workbench 同層的「知識庫」資料夾）
# VAULT_PATH=C:\python\obsidian\知識庫

# ---- Outlook / 學校信箱（Microsoft Graph）----
# Azure Portal → Microsoft Entra ID → 應用程式註冊 → 取得「應用程式 (用戶端) 識別碼」
MS_CLIENT_ID=
# common = 個人 + 學校帳號都可；也可填學校的 tenant 網域，例如 ntu.edu.tw
MS_TENANT=common

# ---- Notion ----
# https://www.notion.so/profile/integrations 建立 internal integration 取得 token
NOTION_TOKEN=
# 課堂筆記資料庫的 ID（資料庫網址中 32 碼那段）
NOTION_DATABASE_ID=
# 資料庫中用來分類課程的欄位名稱（Select / Multi-select / Text）
NOTION_COURSE_PROPERTY=課程
# 每幾分鐘自動同步一次，0 = 只手動同步
NOTION_AUTO_SYNC_MINUTES=0

# PORT=8765
