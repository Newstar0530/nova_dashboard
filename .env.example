# 複製成 .env 後填入（.env 不會被 commit）

# Obsidian vault 路徑（預設為 workbench 同層的「知識庫」資料夾）
# VAULT_PATH=C:\python\obsidian\知識庫

# ---- Gmail（學校信箱轉寄到 Gmail）----
# 需先開啟 Google 兩步驟驗證，再到 https://myaccount.google.com/apppasswords 建立應用程式密碼
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 學校信箱（用來分類轉寄來的信，並提供「開啟學校 Outlook」按鈕）：標籤=地址或網域，用分號分隔
# MAIL_ACCOUNTS=清大=nthu.edu.tw;B校=s456@b.edu.tw
MAIL_ACCOUNTS=

# ---- 每日資訊（Claude 排程任務寄到 Gmail 的報告）----
# 依信件主旨開頭辨識，格式：名稱=主旨開頭，用分號分隔；不填就用預設的四個排程任務
# DAILY_FEEDS=AI daily digest=[AI 每日摘要];Student deals=[留學生交通住宿優惠]

# ---- 天氣（Today 頁世界時鐘）----
# 名稱=緯度,經度，用分號分隔；不填就用新竹與 Rouen
# WEATHER_PLACES=Taipei=25.0330,121.5654;Paris=48.8566,2.3522

# ---- 行事曆（ICS 訂閱，唯讀）----
# 學校 Outlook 網頁版 → 設定 → 行事曆 → 共用行事曆 →「發佈行事曆」→ 複製 ICS 連結
# 格式：標籤=網址，多個用分號分隔
CALENDAR_ICS=

# ---- Notion ----
# https://www.notion.so/profile/integrations 建立 internal integration 取得 token
NOTION_TOKEN=
# 課堂筆記資料庫的 ID（資料庫網址中 32 碼那段）
NOTION_DATABASE_ID=
# 資料庫中用來分類課程的欄位名稱（Select / Multi-select / Text）
NOTION_COURSE_PROPERTY=課程
# 每幾分鐘自動同步一次，0 = 只手動同步
NOTION_AUTO_SYNC_MINUTES=0

# PORT=8765
